rules_version = '2';

// Photos and PDFs attached to posts. Only signed-in staff can read them,
// and each person can only upload into their own folder.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
